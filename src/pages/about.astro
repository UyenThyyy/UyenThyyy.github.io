---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Về mình | Uyên Thy">
  <div class="about-container">
    <div class="about-card">
      <h2 class="title">Xin chào, mình là Thy! ✨</h2>
      <p class="intro">Chào mừng bạn đã ghé thăm góc nhỏ của mình. Dưới đây là một chút thông tin về mình:</p>
      
      <div class="info-grid">
        <div class="info-item">
          <div class="icon-box"><i class="fa-solid fa-signature"></i></div>
          <div class="text-box">
            <span class="label">Họ và tên</span>
            <p class="value">Văn Lê Uyên Thy</p>
          </div>
        </div>

        <div class="info-item">
          <div class="icon-box"><i class="fa-solid fa-location-dot"></i></div>
          <div class="text-box">
            <span class="label">Quê quán</span>
            <p class="value">Đồng Tháp</p>
          </div>
        </div>

        <div class="info-item">
          <div class="icon-box"><i class="fa-solid fa-envelope"></i></div>
          <div class="text-box">
            <span class="label">Email</span>
            <p class="value">10423175@student.vgu.edu.vn</p>
          </div>
        </div>

        <div class="info-item">
          <div class="icon-box"><i class="fa-solid fa-phone"></i></div>
          <div class="text-box">
            <span class="label">Số điện thoại</span>
            <p class="value">0815506606</p>
          </div>
        </div>
      </div>

      <div class="quote">
        "Đang nỗ lực trở thành một kỹ sư phần mềm tại VGU 💻🌸"
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-container {
    display: flex;
    justify-content: center;
    padding-top: 2rem;
  }

  .about-card {
    background: white;
    padding: 3rem;
    border-radius: 30px;
    box-shadow: 0 10px 30px rgba(251, 133, 161, 0.1);
    width: 100%;
    border: 1px solid #ffe3e8;
    text-align: center;
  }

  .title {
    color: #fb85a1;
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .intro {
    color: #888;
    margin-bottom: 3rem;
  }

  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    text-align: left;
  }

  .info-item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem;
    background: #fffafb;
    border-radius: 20px;
    transition: transform 0.3s ease;
  }

  .info-item:hover {
    transform: scale(1.05);
    background: #ffeef2;
  }

  .icon-box {
    width: 50px;
    height: 50px;
    background: white;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fb85a1;
    font-size: 1.2rem;
    box-shadow: 0 4px 10px rgba(251, 133, 161, 0.1);
  }

  .label {
    display: block;
    font-size: 0.8rem;
    color: #aaa;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .value {
    margin: 0;
    font-weight: 700;
    color: #6d5d6e;
    font-size: 1.1rem;
  }

  .quote {
    margin-top: 3rem;
    font-style: italic;
    color: #fb85a1;
    opacity: 0.8;
  }

  /* Mobile responsive */
  @media (max-width: 600px) {
    .info-grid { grid-template-columns: 1fr; }
    .about-card { padding: 1.5rem; }
  }
</style>