---
const { title } = Astro.props;
---
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <title>{title} | My Blog</title>
    <style is:global>
  /* 1. Thiết lập chung: Font chữ và Màu sắc */
  :root {
  --bg-color: #fff5f7; /* Hồng cực nhạt cho nền */
  --text-color: #4a4a4a;
  --accent-color: #ff8fa3; /* Màu hồng Sakura chính */
  --secondary-pink: #ffb3c1;
  --hover-color: #ff4d6d;
  --card-bg: rgba(255, 255, 255, 0.8); /* Màu trắng trong suốt để làm hiệu ứng kính */
  --gradient: linear-gradient(135deg, #ff8fa3 0%, #ffb3c1 100%);
}

  /* Chế độ Dark Mode nhẹ nhàng (nếu Thy muốn) */
  @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@400;600;700&display=swap');

  body {
    font-family: 'Quicksand', sans-serif; /* Font này tròn trịa và dễ thương hơn */
    background-color: var(--bg-color);
    background-image: radial-gradient(#ffcad4 0.5px, transparent 0.5px); /* Chấm bi nhạt cho nền */
    background-size: 20px 20px;
    color: var(--text-color);
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
    line-height: 1.8;
  }

  /* Hiệu ứng chữ Gradient cho tiêu đề */
  h1 {
    background: var(--gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-size: 2.5rem;
    text-align: center;
    animation: float 3s ease-in-out infinite; /* Hiệu ứng bay */
  }

  /* Hiệu ứng bay bổng */
  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
    100% { transform: translateY(0px); }
  }

  /* Navigation Bar kiểu mới */
  nav {
    display: flex;
    justify-content: center;
    gap: 30px;
    margin-bottom: 4rem;
  }

  .nav-link {
    text-decoration: none;
    color: var(--text-color);
    font-weight: 600;
    position: relative;
    padding: 5px 10px;
  }

  /* Hiệu ứng gạch chân khi hover */
  .nav-link::after {
    content: '';
    position: absolute;
    width: 0;
    height: 2px;
    bottom: 0;
    left: 0;
    background-color: var(--accent-color);
    transition: width 0.3s ease;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* Danh sách bài viết kiểu "Kính mờ" (Glassmorphism) */
  li {
    list-style: none;
    background: var(--card-bg);
    backdrop-filter: blur(10px); /* Làm mờ nền phía sau */
    border: 1px solid rgba(255, 255, 255, 0.3);
    margin-bottom: 1.5rem;
    padding: 2rem;
    border-radius: 20px;
    box-shadow: 0 8px 32px 0 rgba(255, 182, 193, 0.2);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  li:hover {
    transform: scale(1.03); /* Phóng to nhẹ khi hover */
    box-shadow: 0 12px 40px 0 rgba(255, 182, 193, 0.4);
    border-color: var(--accent-color);
  }

  li a {
    text-decoration: none;
    color: var(--hover-color);
    font-size: 1.3rem;
    font-weight: 700;
  }

  /* Trang trí thêm cho nội dung bài viết */
  article hr {
    border: none;
    height: 2px;
    background: var(--gradient);
    margin: 2rem 0;
    border-radius: 2px;
  }
</style>
  </head>
  <body>
    <nav>
  <a href="/" class="nav-link">🏠 Trang chủ</a>
  <a href="https://github.com/UyenThyyy" target="_blank" class="nav-link github-link">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 4px;"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.28 1.15-.28 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
    GitHub
  </a>
</nav>
    <main>
      <slot /> </main>
  </body>
</html>