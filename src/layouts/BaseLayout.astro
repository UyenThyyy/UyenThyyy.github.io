---
const { title } = Astro.props;
---
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <title>{title}</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@400;600;700&display=swap');

    :root {
      /* Bảng màu "Sweet Rose" mới - Xinh và dịu mắt hơn */
      --primary-color: #fb85a1;    /* Hồng dâu ngọt ngào */
      --text-color: #6d5d6e;       /* Màu tím tro (Dusty Purple) cho chữ - cực sang */
      --hover-pink: #ff4d6d;
      --bg-color: #fffafb;
      --accent-soft: #ffe3e8;
    }

    body {
      font-family: 'Quicksand', sans-serif;
      background-color: var(--bg-color);
      margin: 0;
      color: var(--text-color);
    }

    /* --- 1. NAVBAR (Đã xóa chữ Shion & Archive) --- */
    nav {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(12px);
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 60px;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 4px 20px rgba(251, 133, 161, 0.08);
    }

    .nav-left {
      color: var(--primary-color);
      font-size: 1.5rem;
      transition: transform 0.3s ease;
    }
    .nav-left:hover { transform: scale(1.1); }

    .nav-links { display: flex; gap: 35px; align-items: center; }
    
    .nav-item { 
      text-decoration: none; 
      color: var(--text-color); /* Màu chữ mới xinh hơn */
      font-weight: 700; 
      font-size: 1rem; 
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.3s ease;
    }

    .nav-item:hover { 
      color: var(--primary-color);
      letter-spacing: 1px; /* Hiệu ứng giãn chữ nhẹ khi hover */
    }

    /* --- 2. HERO & AVATAR (Hiệu ứng xoay & Đổi màu viền) --- */
    .hero-container { position: relative; margin-bottom: 100px; }

    .banner {
      height: 400px;
      width: 100%;
      background: url('/banner.jpg') center/cover;
      border-bottom: 4px solid var(--accent-soft);
    }

    .avatar-box {
      position: absolute;
      bottom: -75px;
      left: 60px;
    }

    .avatar-img {
      width: 160px;
      height: 160px;
      border-radius: 50%;
      border: 6px solid white;
      box-shadow: 0 10px 25px rgba(251, 133, 161, 0.15);
      background: url('/ava.jpg') center/cover;
      
      /* QUAN TRỌNG: Thiết lập transition để mượt mà */
      transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
      cursor: pointer;
    }

    /* HIỆU ỨNG KHI RÊ CHUỘT VÀO AVATAR */
    .avatar-img:hover {
      transform: rotate(10deg) scale(1.05); /* Xoay nhẹ 10 độ và phóng to */
      border-color: var(--primary-color);    /* Đổi viền sang màu hồng */
      box-shadow: 0 0 30px rgba(251, 133, 161, 0.4);
    }

    /* --- 3. PHẦN NỘI DUNG --- */
    .content-wrapper { 
      max-width: 850px; 
      margin: 0 auto; 
      padding: 0 25px 60px; 
    }

    /* --- 4. KIM TUYẾN ✨ --- */
    .sparkle-dot {
      position: absolute;
      pointer-events: none;
      border-radius: 50%;
      z-index: 9999;
      animation: sparkle-fade 0.8s ease-out forwards;
    }

    @keyframes sparkle-fade {
      0% { transform: translateY(0) scale(0); opacity: 1; }
      100% { transform: translateY(20px) scale(1.5); opacity: 0; }
    }
  </style>
</head>
<body>

  <nav>
    <a href="/" class="nav-left">
      <i class="fa-solid fa-house-chimney"></i> </a>
    
    <div class="nav-links">
      <a href="/" class="nav-item">Home</a>
      <a href="/about" class="nav-item">About</a>
      <a href="https://github.com/UyenThyyy" target="_blank" class="nav-item">
        <i class="fa-brands fa-github"></i> GitHub
      </a>
    </div>

    <div style="display: flex; gap: 20px; color: var(--primary-color); font-size: 1.1rem;">
      <i class="fa-solid fa-magnifying-glass"></i>
      <i class="fa-solid fa-wand-magic-sparkles"></i>
    </div>
  </nav>

  <div class="hero-container">
    <div class="banner"></div>
    <div class="avatar-box">
      <div class="avatar-img"></div>
    </div>
  </div>

  <div class="content-wrapper">
    <slot />
  </div>

  <script is:inline>
    document.addEventListener('mousemove', (e) => {
      const sparkle = document.createElement('div');
      sparkle.className = 'sparkle-dot';
      const size = Math.random() * 5 + 3;
      sparkle.style.width = `${size}px`;
      sparkle.style.height = `${size}px`;
      sparkle.style.left = `${e.pageX}px`;
      sparkle.style.top = `${e.pageY}px`;
      
      const colors = ['#fb85a1', '#ffe3e8', '#ffffff', '#ffb3c1'];
      sparkle.style.background = colors[Math.floor(Math.random() * colors.length)];
      sparkle.style.boxShadow = `0 0 8px ${sparkle.style.background}`;

      document.body.appendChild(sparkle);
      setTimeout(() => sparkle.remove(), 800);
    });
  </script>

</body>
</html>